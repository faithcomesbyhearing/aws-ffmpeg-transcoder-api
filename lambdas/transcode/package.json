{
  "lambda": {
    "layers": [
      "FFMPEG",
      "FFPROBE"
    ],
    "environment": [
      "TABLE_NAME"
    ],
    "memory_size": 2048,
    "statements": [
      "GET_IN_BUCKET",
      "PUT_OUT_BUCKET",
      "DYNAMODB_WRITE"
    ],
    "timeout": 900
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.896.0",
    "@aws-sdk/client-s3": "^3.896.0",
    "@aws-sdk/lib-dynamodb": "^3.896.0",
    "@aws-sdk/lib-storage": "^3.896.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  }
}
